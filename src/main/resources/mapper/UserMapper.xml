    <select id="pageUser" resultType="com.example.demo.vo.user.PageUserVO">
        select * from user
        <where>
            <if test="userName!=null">
                user_name=#{userName},
            </if>
            <if test="mail!=null">
                mail=#{mail},
            </if>
            <if test="mobile!=null">
                mobile=#{mobile},
            </if>
            <if test="address!=null">
                address=#{address},
            </if>
            <if test="sexEnum!=null">
                sex_enum=#{sexEnum},
            </if>
            <if test="statusEnum!=null">
                status_enum=#{statusEnum}
            </if>
        </where>
    </select>
